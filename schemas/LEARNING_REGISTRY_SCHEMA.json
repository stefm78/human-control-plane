{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learnit://human-control-plane/learning-registry/v1",
  "title": "Governed Learning Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","registry_identity","updated_at","semantic_authority","state_role","source_of_truth","update_contract","coverage","lifecycle_policy","applicability_model","learnings"],
  "properties": {
    "schema": {"const":"governed-learning-registry.v1"},
    "registry_identity": {"type":"string","pattern":"^sha256-canonical-payload:[0-9a-f]{64}$"},
    "updated_at": {"type":"string"},
    "semantic_authority": {"type":"object","additionalProperties":false,"required":["kernel","version","state_identity"],"properties":{"kernel":{"const":"UAL"},"version":{"const":"1.0"},"state_identity":{"const":"sha256:06b59a480f69f16719498b29c56185392549729a7fae59f7fed33d5b42ec4db2"}}},
    "state_role": {"const":"STATE_NOT_AUTHORITY"},
    "source_of_truth": {"type":"object","additionalProperties":false,"required":["type","canonical_file"],"properties":{"type":{"const":"CHATGPT_LIBRARY_ARTIFACT"},"canonical_file":{"const":"LEARNING_REGISTRY.json"}}},
    "update_contract": {"type":"object"},
    "coverage": {"type":"object"},
    "lifecycle_policy": {"type":"object"},
    "applicability_model": {"type":"object"},
    "learnings": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["learning_id","statement","type","source_event","source_evidence","date_captured","scope","applies_when","does_not_apply_when","confidence","freshness_class","invalidate_if","provenance","reuse_targets","sensitivity","persistence","status","applicability","state_identity"],"properties":{"learning_id":{"type":"string","minLength":1},"statement":{"type":"string","minLength":1},"type":{"type":"string","minLength":1},"source_event":{"type":["string","object"]},"source_evidence":{"type":"array","minItems":1,"items":{"type":["string","object"]}},"date_captured":{"type":"string"},"scope":{"type":"string","enum":["TURN","CONVERSATION","PROJECT","WORKFLOW","DOMAIN","USER_PREFERENCE","GLOBAL_PROCESS_RULE"]},"applies_when":{"type":["array","object","string"]},"does_not_apply_when":{"type":["array","object","string"]},"confidence":{"type":"string","enum":["HIGH","MODERATE","LOW","UNKNOWN"]},"freshness_class":{"type":"string","enum":["STATIC","SLOW_CHANGING","PROJECT_BOUND","ENVIRONMENT_BOUND","TIME_SENSITIVE","EPHEMERAL"]},"valid_until":{"type":["string","null"]},"review_after":{"type":["string","null"]},"invalidate_if":{"type":["array","object","string"]},"provenance":{"type":["array","object"]},"reuse_targets":{"type":"array","items":{"type":"string"}},"sensitivity":{"type":"string"},"persistence":{"type":"string","enum":["ARTIFACT_LEARNING"]},"status":{"type":"string","enum":["CANDIDATE","VALIDATED","DEPRECATED","INVALIDATED","FORGOTTEN"]},"applicability":{"type":"string","enum":["APPLICABLE","NOT_APPLICABLE","STALE","INVALID","UNKNOWN"]},"state_identity":{"type":"string","minLength":1}}}}
  }
