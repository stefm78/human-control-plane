    "snapshot_identity":{"type":"string","pattern":"^sha256-canonical-payload:[0-9a-f]{64}$"},
    "snapshot_id":{"type":"string"},
    "generated_at":{"type":"string"},
    "source_state_identity":{"type":"string"},
    "source_of_truth":{"type":"string"},
    "system_state":{"type":"object"},
    "kernels":{"type":"array"},
    "works":{"type":"array"},
    "partitions":{"type":"array"},
    "learnings":{"type":"array"},
    "artifacts":{"type":"array"},
    "gates":{"type":"array"},
    "warnings":{"type":"array"},
    "attention_items":{"type":"array"},
    "suggested_actions":{"type":"array"},
    "coverage":{"type":"object"}
  }
}
