{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human-control-plane.action-bundle.v1",
  "type": "object",
  "required": ["schema","bundle_id","source_snapshot_id","generated_at","actions","execution_policy","human_selection_proof"],
  "properties": {
    "schema": {"const":"human-control-plane.action-bundle.v1"},
    "bundle_id": {"type":"string","minLength":1},
    "source_snapshot_id": {"type":"string","minLength":1},
    "generated_at": {"type":"string"},
    "actions": {"type":"array","minItems":1,"items":{"$ref":"ACTION_UNIT_SCHEMA.json"}},
    "execution_policy": {"enum":["BEST_EFFORT_INDEPENDENT","ORDERED_STOP_ON_BLOCKER","ALL_OR_STOP"]},
    "human_selection_proof": {"type":"object","required":["selection_method","selected_action_ids"]},
    "optional_notes": {"type":"string"}
  }
}
